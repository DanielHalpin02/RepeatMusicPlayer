<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepeatMusicPlayer.SettingsPage"
             Title="Settings">

    <VerticalStackLayout Padding="20" Spacing="20">

        <HorizontalStackLayout Spacing="10">
            <Label Text="Dark Mode" VerticalOptions="Center" FontSize="16" />
            <Switch x:Name="DarkModeSwitch" Toggled="OnDarkModeToggled" />
        </HorizontalStackLayout>

        <VerticalStackLayout Spacing="5">
            <Label Text="Default Sort Order" FontSize="16" />
            <Picker x:Name="SortOrderPicker" SelectedIndexChanged="OnSortOrderChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Title</x:String>
                        <x:String>Artist</x:String>
                        <x:String>Album</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentPage>