<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepeatMusicPlayer.MainPage"
             Title="Library">

    <VerticalStackLayout>

        <HorizontalStackLayout Spacing="10" Padding="15">
            <Button Text="Playlists" Clicked="OnPlaylistsClicked" />
            <Button Text="Add Song" Clicked="OnAddSongClicked" />
            <Button Text="Scan Folder" Clicked="OnScanFolderClicked" />
            <Button Text="Settings" Clicked="OnSettingsClicked" />
        </HorizontalStackLayout>

        <Entry Placeholder="Search by title or artist"
               Text="{Binding SearchText}"
               Margin="15,0,15,10" />

        <CollectionView x:Name="SongsCollectionView"
                         ItemsSource="{Binding Songs}"
                         SelectionMode="Single"
                         SelectionChanged="OnSongSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource CardStyle}" Margin="15,6">
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding Artist}" FontSize="14" TextColor="{StaticResource Gray400}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>