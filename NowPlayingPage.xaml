<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepeatMusicPlayer.NowPlayingPage"
             Title="Now Playing">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label Text="{Binding CurrentSong.Title}"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Label Text="{Binding CurrentSong.Artist}"
               FontSize="18"
               TextColor="Gray"
               HorizontalOptions="Center" />

        <Slider x:Name="SeekSlider"
                Minimum="0"
                Maximum="{Binding Duration}"
                Value="{Binding Position}"
                DragStarted="OnSeekStarted"
                DragCompleted="OnSeekCompleted" />

        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
            <Button x:Name="ShuffleButton" Text="Shuffle: Off" Clicked="OnShuffleClicked" />
            <Button x:Name="RepeatButton" Text="Repeat: Off" Clicked="OnRepeatClicked" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
            <Button Text="Previous" Clicked="OnPreviousClicked" />
            <Button x:Name="PlayPauseButton"
                    Text="Play"
                    Clicked="OnPlayPauseClicked" />
            <Button Text="Next" Clicked="OnNextClicked" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <Label Text="Volume" VerticalOptions="Center" />
            <Slider x:Name="VolumeSlider"
                    Minimum="0"
                    Maximum="1"
                    Value="{Binding Volume}"
                    WidthRequest="150"
                    ValueChanged="OnVolumeChanged" />
        </HorizontalStackLayout>

    </VerticalStackLayout>

</ContentPage>