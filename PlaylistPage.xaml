<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepeatMusicPlayer.PlaylistPage"
             Title="Playlists">

    <VerticalStackLayout Padding="20" Spacing="15">

        <HorizontalStackLayout Spacing="10">
            <Entry x:Name="PlaylistNameEntry"
                   Placeholder="New playlist name"
                   WidthRequest="200"
                   Text="{Binding NewPlaylistName}" />
            <Button Text="Add" Clicked="OnAddPlaylistClicked" />
        </HorizontalStackLayout>

        <CollectionView ItemsSource="{Binding Playlists}"
                         SelectionMode="Single"
                         SelectionChanged="OnPlaylistSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           BackgroundColor="Red"
                                           Invoked="OnDeletePlaylistSwiped" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Label Text="{Binding Name}" FontSize="18" Padding="0,10" />
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>