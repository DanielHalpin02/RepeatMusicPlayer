<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepeatMusicPlayer.PlaylistPage"
             Title="Playlists">

    <VerticalStackLayout Padding="20" Spacing="15">

        <HorizontalStackLayout Spacing="10">
            <Entry x:Name="PlaylistNameEntry"
                   Placeholder="New playlist name"
                   WidthRequest="200"
                   Text="{Binding NewPlaylistName}" />
            <Button Text="Add" Clicked="OnAddPlaylistClicked" />
        </HorizontalStackLayout>

        <CollectionView ItemsSource="{Binding Playlists}"
                         SelectionMode="Single"
                         SelectionChanged="OnPlaylistSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                        <Label Text="{Binding Name}" FontSize="18" VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Delete"
                                BackgroundColor="Red"
                                TextColor="White"
                                Clicked="OnDeletePlaylistClicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>